    </div>

    <script>
        const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbw_c6XnCYXm1SHwbi-NINAbAuczaaLalzgsdB2BwfGA0NsVp7bjPaGrl0BHhO1EV6sX/exec";

        document.getElementById("formulario").addEventListener("submit", async (e) => {
            e.preventDefault();

            const btnEnviar = document.getElementById("btnEnviar");
            const spinner = document.getElementById("spinner");
            const btnText = document.getElementById("btnText");
            const mensaje = document.getElementById("mensaje");

            // Mostrar loading
            btnEnviar.disabled = true;
            spinner.style.display = "block";
            btnText.textContent = "Guardando...";

            const datos = {
                nombre: document.getElementById("nombre").value,
                tipoEvento: document.getElementById("tipoEvento").value,
                detalles: document.getElementById("detalles").value,
                notas: document.getElementById("notas").value,
                trabajador: document.getElementById("trabajador").value,
                campana: document.getElementById("campana").value || ""
            };

            try {
                const response = await fetch(APPS_SCRIPT_URL, {
                    method: "POST",
                    body: JSON.stringify(datos)
                });

                const resultado = await response.json();

                if (resultado.exito) {
                    mensaje.className = "mensaje exito";
                    mensaje.textContent = "✅ " + resultado.mensaje;
                    document.getElementById("formulario").reset();
                    
                    // Mantener el mensaje por 3 segundos
                    setTimeout(() => {
                        mensaje.style.display = "none";
                    }, 3000);
                } else {
                    mensaje.className = "mensaje error";
                    mensaje.textContent = "❌ Error: " + (resultado.error || "Algo salió mal");
                }
            } catch (error) {
                mensaje.className = "mensaje error";
                mensaje.textContent = "❌ Error de conexión: " + error.message;
            } finally {
                btnEnviar.disabled = false;
                spinner.style.display = "none";
                btnText.textContent = "Guardar Evento";
            }
        });
    </script>
</body>
</html>
